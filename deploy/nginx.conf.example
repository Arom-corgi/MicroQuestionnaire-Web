# Merge into your existing site configuration; replace root/certificate paths.
server {
    listen 80;
    server_name www.kiandfn.cn;
    return 301 https://www.kiandfn.cn$request_uri;
}

server {
    listen 443 ssl;
    server_name www.kiandfn.cn;
    ssl_certificate /etc/letsencrypt/live/www.kiandfn.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.kiandfn.cn/privkey.pem;
    root /var/www/microquestionnaire-web/dist;
    index index.html;

    # This endpoint must return JSON, never the SPA's index.html.
    location = /.well-known/applinking.json {
        default_type application/json;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # Change to your real backend upstream when it differs.
    location /api/ {
        proxy_pass https://api.kiandfn.cn;
        proxy_ssl_server_name on;
        proxy_set_header Host api.kiandfn.cn;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
